/.quarto/
_site/
_site_codex_check/
_render_tmp/
.venv/
.DS_Store
**/.DS_Store

# Instructor-only resources (not for students)
docs/instructor-resources/
docs/instructor/
exams/_prep/
modules/**/_prep/

# Claude Code / MCP configs
.claude/
.playwright-mcp/

# Temporary test files
_test-*

# Rendered HTML in source directories (should be in _site/)
# Quarto outputs to _site/, so HTML in source dirs is accidental
**/*.html

# Quarto reveal/HTML render byproducts (e.g., revealjs libs/ mediabag/)
**/*_files/

# Exception: Demo HTML files are source files, not generated output
!demos/*/index.html
# Quarto output artifact (do not track)
demos/_instructor/index.html

# Quarto support assets sometimes appear in the project root during local renders
site_libs/
**/*-listing.json

# LaTeX build artifacts
**/*.aux
**/*.fdb_latexmk
**/*.fls
**/*.synctex.gz
**/*.log
**/*.tex
**/*.toc
**/*.out
**/*.bbl
**/*.blg

**/*.quarto_ipynb

# Station-card PDFs are built artifacts (the website outputs them in _site/)
demos/**/*-station-card.pdf

# Rendered PDFs next to their sources (Quarto format: pdf)
course-info/*.pdf
handouts/*.pdf
homework/*.pdf
activities/*.pdf


/.luarc.json
*.mp4
*.png
*.PNG

# Course images: we DO track PNGs under assets/images (many existing figures are PNG).
!assets/images/**/*.png
!assets/images/**/*.PNG

# But keep local preview renders out of git.
assets/images/**/_previews/*.png
assets/images/**/_previews/*.PNG
assets/images/**/_previews/*.pdf
assets/images/**/_previews/*.PDF

# Python bytecode / caches
__pycache__/
*.py[cod]
